#!/usr/bin/env bash
set -euo pipefail
umask 077

PLUGIN_ID="spacexrace.screen-mirroring"
DOUBLETAKE_PORT_RANGE="60000-60010"
UFW_PORT_RANGE="60000:60010"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/screen-mirroring"
RUNTIME_ROOT="${XDG_RUNTIME_DIR:-/run/user/$UID}"
STATE_DIR="$RUNTIME_ROOT/omarchy-screen-mirroring"
SETTINGS_FILE="$CONFIG_DIR/settings.json"
PERMANENT_IPS_FILE="$CONFIG_DIR/permanent-ips"
PENDING_CLEANUP_FILE="$CONFIG_DIR/pending-cleanup.json"
SOCKET="$STATE_DIR/doubletake.sock"
PID_FILE="$STATE_DIR/doubletake.pid"
PID_START_FILE="$STATE_DIR/doubletake.starttime"
STREAM_PID_FILE="$STATE_DIR/stream.pid"
STREAM_PGID_FILE="$STATE_DIR/stream.pgid"
STREAM_START_FILE="$STATE_DIR/stream.starttime"
STREAM_IP_FILE="$STATE_DIR/stream.ip"
STREAM_INPUT_FILE="$STATE_DIR/stream.input"
STREAM_LOG_MARK_FILE="$STATE_DIR/stream.log-offset"
STREAM_CREDENTIAL_SUBMITTED_FILE="$STATE_DIR/stream.credential-submitted"
LEGACY_CLEANUP_IP_FILE="$STATE_DIR/cleanup.ip"
CLEANUP_IN_PROGRESS_FILE="$STATE_DIR/cleanup.in-progress"
CLEANUP_ATTEMPTED_FILE="$STATE_DIR/cleanup.attempted"
OPERATION_LOCK_FILE="$STATE_DIR/operation.lock"
LOG_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-screen-mirroring/doubletake.log"
PKEXEC=/usr/bin/pkexec
UFW=/usr/bin/ufw
FLOCK=/usr/bin/flock
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
FIREWALL_RULES_MAY_EXIST=false

json_error() {
  python - "$1" <<'PY'
import json, sys
print(json.dumps({"ok": False, "error": sys.argv[1]}))
PY
  exit 1
}

ensure_private_state_dir() {
  python - "$RUNTIME_ROOT" <<'PY'
import os, stat, sys

root = sys.argv[1]
uid = os.getuid()
flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW

try:
    root_fd = os.open(root, flags)
    root_stat = os.fstat(root_fd)
    if root_stat.st_uid != uid or root_stat.st_mode & 0o077:
        raise PermissionError("runtime root must be owned by the current user and have mode 0700")

    try:
        os.mkdir("omarchy-screen-mirroring", mode=0o700, dir_fd=root_fd)
    except FileExistsError:
        pass

    state_fd = os.open("omarchy-screen-mirroring", flags, dir_fd=root_fd)
    state_stat = os.fstat(state_fd)
    if state_stat.st_uid != uid:
        raise PermissionError("runtime state directory is not owned by the current user")
    os.fchmod(state_fd, 0o700)
    os.close(state_fd)
    os.close(root_fd)
except (OSError, PermissionError) as error:
    print(error, file=sys.stderr)
    sys.exit(1)
PY
}

lock_operations() {
  [[ -x "$FLOCK" ]] || json_error "flock is not installed"
  exec 9>"$OPERATION_LOCK_FILE"
  "$FLOCK" -x 9
}

update_pending_cleanup() {
  local action=$1 ip=${2:-}
  mkdir -p "$CONFIG_DIR"
  python - "$PENDING_CLEANUP_FILE" "$action" "$ip" <<'PY'
import ipaddress, json, os, stat, sys, tempfile

path, action, raw_ip = sys.argv[1:]
directory = os.path.dirname(path)

def canonical(value):
    return str(ipaddress.ip_address(value))

def load_values():
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return []
    try:
        info = os.fstat(fd)
        if info.st_uid != os.getuid() or not stat.S_ISREG(info.st_mode):
            raise PermissionError("pending cleanup state is not a private regular file")
        with os.fdopen(fd, encoding="utf-8") as stream:
            data = json.load(stream)
        fd = -1
    finally:
        if fd >= 0:
            os.close(fd)
    if not isinstance(data, list):
        raise ValueError("pending cleanup state must be a JSON list")
    return sorted(set(canonical(value) for value in data))

def persist(values):
    if not values:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    else:
        fd, temporary = tempfile.mkstemp(dir=directory, prefix=".pending-cleanup-")
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                fd = -1
                json.dump(values, stream)
                stream.write("\n")
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, path)
        finally:
            if fd >= 0:
                os.close(fd)
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
    directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)

values = load_values()
if action == "add":
    values = sorted(set(values + [canonical(raw_ip)]))
    persist(values)
elif action == "remove":
    target = canonical(raw_ip)
    persist([value for value in values if value != target])
elif action == "list":
    for value in values:
        print(value)
else:
    raise ValueError("unknown pending cleanup action")
PY
}

pending_cleanup_add() {
  update_pending_cleanup add "$1"
  rm -f "$CLEANUP_ATTEMPTED_FILE"
}

pending_cleanup_remove() {
  update_pending_cleanup remove "$1"
}

pending_cleanup_list() {
  update_pending_cleanup list
}

pending_cleanup_has_entries() {
  [[ -f "$PENDING_CLEANUP_FILE" ]]
}

migrate_legacy_cleanup_state() {
  [[ -f "$LEGACY_CLEANUP_IP_FILE" ]] || return 0
  local ip
  ip="$(<"$LEGACY_CLEANUP_IP_FILE")"
  ip="$(validate_ip "$ip")" || json_error "Stored receiver IP is invalid"
  pending_cleanup_add "$ip"
  rm -f "$LEGACY_CLEANUP_IP_FILE"
}

prepare_log_file() {
  mkdir -p "$(dirname "$LOG_FILE")"
  : >> "$LOG_FILE"
  chmod 600 "$LOG_FILE"
}

settings_value() {
  local key=$1
  [[ -f "$SETTINGS_FILE" ]] || return 0
  python - "$SETTINGS_FILE" "$key" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        data = json.load(f)
    print(data.get(sys.argv[2], ""))
except Exception:
    pass
PY
}

save_settings() {
  mkdir -p "$CONFIG_DIR"
  python - "$SETTINGS_FILE" "$1" "$2" <<'PY'
import json, os, sys, tempfile
path, key, value = sys.argv[1:]
data = {}
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    pass
data[key] = value
fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".settings-")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(data, f)
    f.write("\n")
os.replace(temporary, path)
PY
}

managed_extra_args() {
  local raw=$1
  python - "$raw" <<'PY'
import shlex, sys
try:
    args = shlex.split(sys.argv[1])
except ValueError as error:
    print(error, file=sys.stderr)
    sys.exit(2)

boolean_options = {"-no-audio", "-no-cursor", "-pair"}
value_options = {
    "-bitrate": ("integer", 0, 100000),
    "-fps": ("integer", 1, 240),
    "-hwaccel": ("choice", {"auto", "nvenc", "vaapi", "none"}),
    "-target-latency-ms": ("integer", 0, 60000),
}

validated = []
index = 0
while index < len(args):
    arg = args[index]
    option, separator, inline_value = arg.partition("=")
    if option in boolean_options:
        if separator:
            print(option + " does not accept a value", file=sys.stderr)
            sys.exit(2)
        validated.append(option)
        index += 1
        continue
    if option not in value_options:
        print("extra argument is not allowed: " + option, file=sys.stderr)
        sys.exit(2)
    if separator:
        value = inline_value
    else:
        index += 1
        if index >= len(args):
            print(option + " requires a value", file=sys.stderr)
            sys.exit(2)
        value = args[index]
    if "\n" in value or "\r" in value:
        print(option + " contains an invalid newline", file=sys.stderr)
        sys.exit(2)
    rule = value_options[option]
    if rule[0] == "integer":
        try:
            number = int(value)
        except ValueError:
            print(option + " requires an integer", file=sys.stderr)
            sys.exit(2)
        if not rule[1] <= number <= rule[2]:
            print(option + " is outside the allowed range", file=sys.stderr)
            sys.exit(2)
    elif value not in rule[1]:
        print(option + " has an invalid value", file=sys.stderr)
        sys.exit(2)
    validated.extend((option, value))
    index += 1

for arg in validated:
    print(arg)
PY
}

parse_extra_args() {
  local raw=$1 output
  local -n destination=$2
  output="$(managed_extra_args "$raw")" || json_error "Invalid extra arguments"
  destination=()
  [[ -z "$output" ]] || mapfile -t destination <<< "$output"
}

process_starttime() {
  local pid=$1
  python - "$pid" <<'PY'
import sys
try:
    with open("/proc/" + sys.argv[1] + "/stat", encoding="utf-8") as f:
        stat = f.read()
    fields = stat[stat.rfind(")") + 2:].split()
    print(fields[19])
except (OSError, IndexError, ValueError):
    sys.exit(1)
PY
}

record_process_identity() {
  local pid=$1 pid_file=$2 start_file=$3 starttime
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  starttime="$(process_starttime "$pid")" || return 1
  printf '%s\n' "$pid" > "$pid_file"
  printf '%s\n' "$starttime" > "$start_file"
}

process_identity_matches() {
  local pid=$1 saved_start=$2 current_start executable
  [[ "$pid" =~ ^[1-9][0-9]*$ && "$saved_start" =~ ^[0-9]+$ ]] || return 1
  current_start="$(process_starttime "$pid")" || return 1
  [[ "$current_start" == "$saved_start" ]] || return 1
  executable="$(readlink -f "/proc/$pid/exe")" || return 1
  [[ "${executable##*/}" == "doubletake" ]]
}

process_matches() {
  local pid_file=$1 start_file=$2 pid saved_start
  [[ -f "$pid_file" && -f "$start_file" ]] || return 1
  pid="$(<"$pid_file")"
  saved_start="$(<"$start_file")"
  process_identity_matches "$pid" "$saved_start"
}

deps() {
  python <<'PY'
import json, shutil, subprocess

official = [
    "gstreamer", "gst-plugins-base", "gst-plugins-good", "gst-plugins-bad",
    "gst-plugins-ugly", "gst-libav", "gst-plugin-va", "libva-utils",
    "libpulse", "pipewire", "util-linux", "xdg-desktop-portal",
    "xdg-desktop-portal-hyprland", "xdg-terminal-exec", "ufw", "polkit", "python",
]
aur = ["doubletake"]
commands = [
    "doubletake", "doubletake-ctl", "flock", "gst-inspect-1.0", "pactl", "pipewire",
    "python", "ufw", "pkexec", "vainfo", "xdg-terminal-exec",
]

missing_packages = []
if shutil.which("pacman"):
    for package in official + aur:
        result = subprocess.run(["pacman", "-Q", package], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if result.returncode != 0:
            missing_packages.append(package)
missing_commands = [command for command in commands if not shutil.which(command)]

gst_elements = ["pipewiresrc", "h264parse"]
missing_elements = []
if shutil.which("gst-inspect-1.0"):
    for element in gst_elements:
        result = subprocess.run(["gst-inspect-1.0", element], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if result.returncode != 0:
            missing_elements.append(element)
else:
    missing_elements = gst_elements

vaapi = bool(shutil.which("vainfo") and shutil.which("gst-inspect-1.0"))
if vaapi:
    vaapi = subprocess.run(["gst-inspect-1.0", "vah264enc"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

missing = list(dict.fromkeys(missing_packages + missing_commands + missing_elements))
print(json.dumps({
    "ok": True,
    "installed": not missing,
    "missing": missing,
    "missingPackages": missing_packages,
    "missingCommands": missing_commands,
    "missingGstreamerElements": missing_elements,
    "vaapi": vaapi,
    "officialPackages": official,
    "aurPackages": aur,
}))
PY
}

daemon_running() {
  [[ -S "$SOCKET" ]] && doubletake-ctl -socket "$SOCKET" status >/dev/null 2>&1
}

stream_running() {
  process_matches "$STREAM_PID_FILE" "$STREAM_START_FILE"
}

stream_group_running() {
  stream_running && [[ "$(<"$STREAM_PGID_FILE")" == "$(<"$STREAM_PID_FILE")" ]] && kill -0 -- "-$(<"$STREAM_PGID_FILE")" 2>/dev/null
}

terminate_stream_processes() {
  local signal=${1:-TERM}
  if stream_group_running; then
    kill -"$signal" -- "-$(<"$STREAM_PGID_FILE")" 2>/dev/null || true
  elif stream_running; then
    kill -"$signal" "$(<"$STREAM_PID_FILE")" 2>/dev/null || true
  fi
}

ensure_daemon() {
  command -v doubletake >/dev/null || json_error "doubletake is not installed"
  command -v doubletake-ctl >/dev/null || json_error "doubletake-ctl is not installed"
  daemon_running && return
  mkdir -p "$STATE_DIR"
  rm -f "$SOCKET"
  local extra
  extra="$(settings_value extraArgs)"
  local -a args=(doubletake -daemonize -socket "$SOCKET" -port-range "$DOUBLETAKE_PORT_RANGE")
  if [[ -n "$extra" ]]; then
    local -a parsed=()
    parse_extra_args "$extra" parsed
    args+=("${parsed[@]}")
  fi
  prepare_log_file
  "${args[@]}" >>"$LOG_FILE" 2>&1 9>&- &
  record_process_identity "$!" "$PID_FILE" "$PID_START_FILE" || json_error "Unable to identify doubletake daemon"
  for _ in {1..20}; do
    daemon_running && return
    sleep 0.15
  done
  json_error "Unable to start doubletake"
}

ctl() {
  ensure_daemon
  doubletake-ctl -socket "$SOCKET" "$@"
}

firewall_comment() {
  printf '%s-%s' "$PLUGIN_ID" "$1"
}

validate_ip() {
  python - "$1" <<'PY'
import ipaddress, sys
try:
    print(ipaddress.ip_address(sys.argv[1]))
except ValueError:
    sys.exit(1)
PY
}

open_firewall() {
  local ip=$1
  ip="$(validate_ip "$ip")" || json_error "Receiver IP is invalid"
  FIREWALL_RULES_MAY_EXIST=true
  if ! "$PKEXEC" "$UFW" allow from "$ip" proto udp to any port "$UFW_PORT_RANGE" comment "$(firewall_comment "$ip")" >/dev/null; then
    json_error "Unable to open the UDP firewall rule; firewall cleanup may still be required"
  fi
  if ! "$PKEXEC" "$UFW" allow from "$ip" proto tcp to any port "$UFW_PORT_RANGE" comment "$(firewall_comment "$ip")" >/dev/null; then
    if ! "$PKEXEC" "$UFW" --force delete allow from "$ip" proto udp to any port "$UFW_PORT_RANGE" comment "$(firewall_comment "$ip")" >/dev/null; then
      json_error "Unable to open the TCP firewall rule; the UDP rule still requires cleanup"
    fi
    FIREWALL_RULES_MAY_EXIST=false
    pending_cleanup_remove "$ip"
    json_error "Unable to open the TCP firewall rule; the UDP rule was rolled back"
  fi
}

close_firewall() {
  local ip=$1 comment failed=false
  ip="$(validate_ip "$ip")" || return 1
  comment="$(firewall_comment "$ip")"
  if ! "$PKEXEC" "$UFW" --force delete allow from "$ip" proto udp to any port "$UFW_PORT_RANGE" comment "$comment" >/dev/null; then
    failed=true
  fi
  if ! "$PKEXEC" "$UFW" --force delete allow from "$ip" proto tcp to any port "$UFW_PORT_RANGE" comment "$comment" >/dev/null; then
    failed=true
  fi
  [[ "$failed" == "true" ]] || FIREWALL_RULES_MAY_EXIST=false
  [[ "$failed" == "false" ]]
}

permanent_ports_enabled() {
  [[ "$(settings_value permanentPorts)" == "true" ]]
}

permanent_ip_exists() {
  [[ -f "$PERMANENT_IPS_FILE" ]] && grep -Fxq "$1" "$PERMANENT_IPS_FILE"
}

mark_permanent_ip() {
  mkdir -p "$CONFIG_DIR"
  permanent_ip_exists "$1" || printf '%s\n' "$1" >> "$PERMANENT_IPS_FILE"
}

open_ports_for_connection() {
  local ip=$1
  if permanent_ports_enabled && permanent_ip_exists "$ip"; then return; fi
  pending_cleanup_add "$ip"
  open_firewall "$ip"
  if permanent_ports_enabled; then
    mark_permanent_ip "$ip"
    pending_cleanup_remove "$ip"
  fi
}

close_ports_after_connection() {
  local ip=$1
  if permanent_ports_enabled && permanent_ip_exists "$ip"; then
    pending_cleanup_remove "$ip"
    return
  fi
  close_firewall "$ip" || return 1
  pending_cleanup_remove "$ip"
}

queue_port_cleanup() {
  pending_cleanup_add "$1"
}

active_stream_uses_ip() {
  local ip=$1
  stream_running && [[ -f "$STREAM_IP_FILE" ]] && [[ "$(<"$STREAM_IP_FILE")" == "$ip" ]]
}

attempt_port_cleanup() {
  pending_cleanup_has_entries || return 0
  local ip output failed=false
  local -a pending_ips=()
  output="$(pending_cleanup_list)" || return 1
  [[ -z "$output" ]] || mapfile -t pending_ips <<< "$output"
  : > "$CLEANUP_IN_PROGRESS_FILE"
  for ip in "${pending_ips[@]}"; do
    active_stream_uses_ip "$ip" && continue
    if ! close_ports_after_connection "$ip"; then failed=true; fi
  done
  rm -f "$CLEANUP_IN_PROGRESS_FILE"
  pending_cleanup_has_entries || rm -f "$CLEANUP_ATTEMPTED_FILE"
  [[ "$failed" == "false" ]]
}

pending_cleanup_required() {
  pending_cleanup_has_entries || return 1
  local ip output
  output="$(pending_cleanup_list)" || return 0
  while IFS= read -r ip; do
    [[ -z "$ip" ]] && continue
    active_stream_uses_ip "$ip" || return 0
  done <<< "$output"
  return 1
}

cleanup_finished_stream() {
  if [[ ! -f "$STREAM_PID_FILE" ]]; then
    if pending_cleanup_has_entries && [[ ! -f "$CLEANUP_ATTEMPTED_FILE" ]]; then
      : > "$CLEANUP_ATTEMPTED_FILE"
      attempt_port_cleanup || true
    fi
    return 0
  fi
  stream_running && return 0
  terminate_stream_processes
  for _ in {1..20}; do stream_group_running || break; sleep 0.05; done
  stream_group_running && terminate_stream_processes KILL
  local ip=""
  [[ -f "$STREAM_IP_FILE" ]] && ip="$(<"$STREAM_IP_FILE")"
  [[ -z "$ip" ]] || queue_port_cleanup "$ip"
  rm -f "$STREAM_PID_FILE" "$STREAM_PGID_FILE" "$STREAM_START_FILE" "$STREAM_IP_FILE" "$STREAM_INPUT_FILE" "$STREAM_LOG_MARK_FILE" "$STREAM_CREDENTIAL_SUBMITTED_FILE"
  attempt_port_cleanup || true
}

stream_connection_state() {
  [[ -p "$STREAM_INPUT_FILE" ]] || return 0
  local offset=0
  [[ -f "$STREAM_LOG_MARK_FILE" ]] && offset="$(<"$STREAM_LOG_MARK_FILE")"
  local submitted=false
  [[ -f "$STREAM_CREDENTIAL_SUBMITTED_FILE" ]] && submitted=true
  python - "$LOG_FILE" "$offset" "$submitted" <<'PY'
import sys
try:
    with open(sys.argv[1], "rb") as f:
        f.seek(int(sys.argv[2]))
        text = f.read().decode("utf-8", "replace").lower()
except Exception:
    text = ""
submitted = sys.argv[3] == "true"
pin_at = text.rfind("enter the pin shown")
password_at = max(text.rfind("enter the receiver's configured password"), text.rfind("configured password or pairing pin"))
if not submitted and max(pin_at, password_at) >= 0:
    print("pin_required password" if password_at > pin_at else "pin_required pin")
elif "screen capture started" in text:
    print("streaming")
else:
    print("connecting")
PY
}

discover() {
  local response
  # The daemon writes discovered devices only after its five-second mDNS browse
  # completes. Keep this request open so the panel's scanning state is honest.
  for _ in {1..12}; do
    response="$(ctl devices)"
    if python - "$response" <<'PY'
import json, sys
try:
    raise SystemExit(0 if json.loads(sys.argv[1]).get("devices") else 1)
except Exception:
    raise SystemExit(1)
PY
    then
      printf '%s\n' "$response"
      return
    fi
    sleep 0.5
  done
  printf '%s\n' "$response"
}

device_name_for_ip() {
  local ip=$1 response
  daemon_running || return 0
  response="$(doubletake-ctl -socket "$SOCKET" devices 2>/dev/null || true)"
  python - "$response" "$ip" <<'PY'
import json, sys
try:
    for device in json.loads(sys.argv[1]).get("devices", []):
        if device.get("ip") == sys.argv[2]:
            print(device.get("name", ""))
            break
except Exception:
    pass
PY
}

start_stream_supervisor() {
  local pid=$1 starttime=$2 ip=$3
  setsid "$SCRIPT_PATH" supervise "$pid" "$starttime" "$ip" </dev/null >>"$LOG_FILE" 2>&1 9>&- &
}

supervise_stream() {
  local expected_pid=$1 expected_start=$2 expected_ip=$3
  [[ "$expected_pid" =~ ^[1-9][0-9]*$ && "$expected_start" =~ ^[0-9]+$ ]] || return 1
  expected_ip="$(validate_ip "$expected_ip")" || return 1

  while process_identity_matches "$expected_pid" "$expected_start"; do sleep 1; done

  lock_operations
  if [[ -f "$STREAM_PID_FILE" && -f "$STREAM_START_FILE" ]] \
    && [[ "$(<"$STREAM_PID_FILE")" == "$expected_pid" ]] \
    && [[ "$(<"$STREAM_START_FILE")" == "$expected_start" ]]; then
    cleanup_finished_stream
  else
    # Another stream may already have replaced this one. Cleanup skips any IP
    # that is still owned by the active stream.
    attempt_port_cleanup || true
  fi
}

CONNECT_IP=""
CONNECT_COMMITTED=false
CONNECT_STARTED_PID=""

cleanup_incomplete_connect() {
  [[ "$CONNECT_COMMITTED" == "false" ]] || return 0
  if [[ "$CONNECT_STARTED_PID" =~ ^[1-9][0-9]*$ ]]; then
    kill -TERM -- "-$CONNECT_STARTED_PID" 2>/dev/null || kill -TERM "$CONNECT_STARTED_PID" 2>/dev/null || true
  fi
  if [[ -n "$CONNECT_IP" ]]; then
    if [[ "$FIREWALL_RULES_MAY_EXIST" == "true" ]]; then
      close_ports_after_connection "$CONNECT_IP" || true
    else
      pending_cleanup_remove "$CONNECT_IP" || true
    fi
  fi
  rm -f "$STREAM_PID_FILE" "$STREAM_PGID_FILE" "$STREAM_START_FILE" "$STREAM_IP_FILE" "$STREAM_INPUT_FILE" "$STREAM_LOG_MARK_FILE" "$STREAM_CREDENTIAL_SUBMITTED_FILE"
}

disconnect_stream() {
  local ip=""
  [[ -f "$STREAM_IP_FILE" ]] && ip="$(<"$STREAM_IP_FILE")"
  if stream_running || stream_group_running; then
    terminate_stream_processes
    for _ in {1..50}; do stream_group_running || stream_running || break; sleep 0.1; done
    if stream_running || stream_group_running; then terminate_stream_processes KILL; fi
  fi
  [[ -z "$ip" ]] || queue_port_cleanup "$ip"
  rm -f "$STREAM_PID_FILE" "$STREAM_PGID_FILE" "$STREAM_START_FILE" "$STREAM_IP_FILE" "$STREAM_INPUT_FILE" "$STREAM_LOG_MARK_FILE" "$STREAM_CREDENTIAL_SUBMITTED_FILE"
  attempt_port_cleanup || true
  status
}

shutdown_if_idle() {
  daemon_running || return 0
  local state
  state="$(doubletake-ctl -socket "$SOCKET" status | python -c 'import json,sys; print(json.load(sys.stdin).get("state", ""))' 2>/dev/null || true)"
  [[ "$state" == "idle" ]] || return 0
  if process_matches "$PID_FILE" "$PID_START_FILE"; then
    kill "$(<"$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE" "$PID_START_FILE" "$SOCKET"
  fi
}

status() {
  cleanup_finished_stream
  local cleanup_required=false
  if [[ ! -f "$CLEANUP_IN_PROGRESS_FILE" ]] && pending_cleanup_required; then cleanup_required=true; fi
  if stream_running; then
    local ip name connection_state connection_state_raw credential_kind
    ip="$(<"$STREAM_IP_FILE")"
    name="$(settings_value lastReceiverName)"
    connection_state_raw="$(stream_connection_state)"
    connection_state="${connection_state_raw%% *}"
    credential_kind="${connection_state_raw#pin_required }"
    [[ "$connection_state" == pin_required* ]] || credential_kind=""
    python - "$ip" "$name" "$connection_state" "$credential_kind" "$(settings_value lastReceiver)" "$(settings_value extraArgs)" "$(settings_value permanentPorts)" "$cleanup_required" <<'PY'
import json, sys
ip, name, state, credential_kind = sys.argv[1:5]
stream = {"device": name or ip, "device_ip": ip, "state": state}
if credential_kind:
    stream["credential_kind"] = credential_kind
print(json.dumps({"ok": True, "state": state, "streams": [stream], "lastReceiver": sys.argv[5], "extraArgs": sys.argv[6], "permanentPorts": sys.argv[7] == "true", "cleanupRequired": sys.argv[8] == "true"}))
PY
    return
  fi
  rm -f "$STREAM_PID_FILE" "$STREAM_PGID_FILE" "$STREAM_START_FILE" "$STREAM_IP_FILE" "$STREAM_INPUT_FILE" "$STREAM_LOG_MARK_FILE" "$STREAM_CREDENTIAL_SUBMITTED_FILE"
  if daemon_running; then
    local response
    response="$(ctl status)"
    python - "$response" "$(settings_value lastReceiver)" "$(settings_value extraArgs)" "$(settings_value permanentPorts)" "$cleanup_required" <<'PY'
import json, sys
data = json.loads(sys.argv[1])
data["lastReceiver"] = sys.argv[2]
data["extraArgs"] = sys.argv[3]
data["permanentPorts"] = sys.argv[4] == "true"
data["cleanupRequired"] = sys.argv[5] == "true"
print(json.dumps(data))
PY
  else
    python - "$(settings_value lastReceiver)" "$(settings_value extraArgs)" "$(settings_value permanentPorts)" "$cleanup_required" <<'PY'
import json, sys
print(json.dumps({"ok": True, "state": "idle", "streams": [], "lastReceiver": sys.argv[1], "extraArgs": sys.argv[2], "permanentPorts": sys.argv[3] == "true", "cleanupRequired": sys.argv[4] == "true"}))
PY
  fi
}

main() {
  ensure_private_state_dir || json_error "Unable to create a private runtime state directory"
  case "${1:-}" in
    deps|supervise) ;;
    *)
      lock_operations
      migrate_legacy_cleanup_state
      ;;
  esac

  case "${1:-}" in
  deps) deps ;;
  save-extra-args)
    parsed=()
    parse_extra_args "${2:-}" parsed
    save_settings extraArgs "${2:-}"
    shutdown_if_idle
    status
    ;;
  discover)
    discover
    ;;
  connect)
    ip=${2:-}
    name=${3:-}
    [[ -n "$ip" ]] || json_error "Receiver IP is required"
    ip="$(validate_ip "$ip")" || json_error "Receiver IP is invalid"
    stream_running && json_error "A screen mirroring stream is already active"
    if [[ -z "$name" && "$(settings_value lastReceiver)" == "$ip" ]]; then
      name="$(settings_value lastReceiverName)"
    fi
    if [[ -z "$name" ]]; then name="$(device_name_for_ip "$ip")"; fi
    CONNECT_IP=$ip
    CONNECT_COMMITTED=false
    CONNECT_STARTED_PID=""
    FIREWALL_RULES_MAY_EXIST=false
    trap cleanup_incomplete_connect EXIT
    shutdown_if_idle
    open_ports_for_connection "$ip"
    save_settings lastReceiver "$ip"
    save_settings lastReceiverName "$name"
    extra="$(settings_value extraArgs)"
    args=(doubletake -target "$ip" -port-range "$DOUBLETAKE_PORT_RANGE")
    if [[ -n "$extra" ]]; then
      parsed=()
      parse_extra_args "$extra" parsed
      args+=("${parsed[@]}")
    fi
    prepare_log_file
    rm -f "$STREAM_INPUT_FILE" "$STREAM_CREDENTIAL_SUBMITTED_FILE"
    mkfifo "$STREAM_INPUT_FILE"
    stat -c %s "$LOG_FILE" 2>/dev/null > "$STREAM_LOG_MARK_FILE" || printf 0 > "$STREAM_LOG_MARK_FILE"
    exec {stream_input_fd}<>"$STREAM_INPUT_FILE"
    setsid "${args[@]}" <"$STREAM_INPUT_FILE" >>"$LOG_FILE" 2>&1 9>&- &
    CONNECT_STARTED_PID=$!
    exec {stream_input_fd}>&-
    if ! record_process_identity "$CONNECT_STARTED_PID" "$STREAM_PID_FILE" "$STREAM_START_FILE"; then
      json_error "Unable to identify doubletake stream"
    fi
    printf '%s\n' "$CONNECT_STARTED_PID" > "$STREAM_PGID_FILE"
    printf '%s\n' "$ip" > "$STREAM_IP_FILE"
    sleep 0.2
    if ! stream_running; then
      json_error "doubletake exited before screen capture started"
    fi
    start_stream_supervisor "$CONNECT_STARTED_PID" "$(<"$STREAM_START_FILE")" "$ip"
    CONNECT_COMMITTED=true
    trap - EXIT
    status
    ;;
  credential)
    ip=${2:-}
    IFS= read -r credential || credential=""
    [[ -n "$ip" && -n "$credential" ]] || json_error "Receiver and credential are required"
    [[ -p "$STREAM_INPUT_FILE" && -f "$STREAM_IP_FILE" && "$(<"$STREAM_IP_FILE")" == "$ip" ]] || json_error "No stream is waiting for a credential"
    stream_running || json_error "No stream is waiting for a credential"
    if ! python -c '
import os, sys
path = sys.argv[1]
data = sys.stdin.buffer.readline(4097)
if len(data) > 4096:
    raise SystemExit("credential is too long")
if not data.endswith(b"\n"):
    data += b"\n"
fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
try:
    if os.write(fd, data) != len(data):
        raise OSError("short credential write")
finally:
    os.close(fd)
' "$STREAM_INPUT_FILE" <<< "$credential"; then
      json_error "Unable to submit the credential"
    fi
    : > "$STREAM_CREDENTIAL_SUBMITTED_FILE"
    status
    ;;
  supervise)
    supervise_stream "${2:-}" "${3:-}" "${4:-}"
    ;;
  disconnect) disconnect_stream ;;
  close-ports)
    attempt_port_cleanup || true
    status
    ;;
  save-permanent-ports)
    enabled=${2:-false}
    [[ "$enabled" == "true" || "$enabled" == "false" ]] || json_error "Invalid permanent ports setting"
    if [[ "$enabled" == "false" && -f "$PERMANENT_IPS_FILE" ]]; then
      cleanup_failed=false
      while IFS= read -r ip; do
        [[ -z "$ip" ]] || {
          ip="$(validate_ip "$ip")" || json_error "Stored receiver IP is invalid"
          queue_port_cleanup "$ip"
          if close_firewall "$ip"; then
            pending_cleanup_remove "$ip"
          else
            cleanup_failed=true
          fi
        }
      done < "$PERMANENT_IPS_FILE"
      [[ "$cleanup_failed" == "false" ]] || json_error "Unable to remove all retained firewall rules"
      rm -f "$PERMANENT_IPS_FILE"
    fi
    save_settings permanentPorts "$enabled"
    status
    ;;
  shutdown-if-idle) shutdown_if_idle ;;
  status) status ;;
  *) json_error "Unknown command: ${1:-}" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
